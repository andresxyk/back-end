<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
    "-//Hibernate/Hibernate Mapping DTD 2.0//EN"
    "http://hibernate.sourceforge.net/hibernate-mapping-2.0.dtd" >
    
<hibernate-mapping>
<!-- 
    Created by the Middlegen Hibernate plugin

    http://boss.bekk.no/boss/middlegen/
    http://hibernate.sourceforge.net/
-->

<class 
    name="mx.com.web2lab.backend.hbm.om.ap.TCorteCaja" 
    table="t_corte_caja"
>

    <id
        name="kcortecaja"
        type="int"
        column="kcortecaja"
    >
        <generator class="sequence">
             	<param name="sequence">tcortecaja_sequence</param>
        </generator>
    </id>

    <property
        name="dregistro"
        type="java.sql.Timestamp"
        column="dregistro"
        length="29"
    />
    <property
        name="ucortecajasucursal"
        type="int"
        column="ucortecajasucursal"
        length="8"
    />

    <!-- associations -->
    <!-- bi-directional many-to-one association to CSucursal -->
    <many-to-one
        name="csucursal"
        class="mx.com.web2lab.backend.hbm.om.ap.CSucursal"
        not-null="true"
    >
        <column name="csucursal" />
    </many-to-one>
    <!-- bi-directional one-to-many association to TPagoPaciente -->
    <set
        name="tpagopacientes"
        lazy="true"
        inverse="true"
    >
        <key>
            <column name="kcortecaja" />
        </key>
        <one-to-many 
            class="mx.com.web2lab.backend.hbm.om.ap.TPagoPaciente"
        />
    </set>
    <!-- bi-directional one-to-many association to TGastoSucursal -->
    <set
        name="tgastosucursals"
        lazy="true"
        inverse="true"
    >
        <key>
            <column name="kcortecaja" />
        </key>
        <one-to-many 
            class="mx.com.web2lab.backend.hbm.om.ap.TGastoSucursal"
        />
    </set>
    <!-- bi-directional one-to-many association to TCorteCajaArqueo -->
    <set
        name="tcortecajaarqueos"
        lazy="true"
        inverse="true"
    >
        <key>
            <column name="kcortecaja" />
        </key>
        <one-to-many 
            class="mx.com.web2lab.backend.hbm.om.ap.TCorteCajaArqueo"
        />
    </set>

</class>
</hibernate-mapping>
