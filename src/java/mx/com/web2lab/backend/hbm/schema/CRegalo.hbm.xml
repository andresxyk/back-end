<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
    "-//Hibernate/Hibernate Mapping DTD 2.0//EN"
    "http://hibernate.sourceforge.net/hibernate-mapping-2.0.dtd" >
    
<hibernate-mapping>
<!-- 
    Created by the Middlegen Hibernate plugin

    http://boss.bekk.no/boss/middlegen/
    http://hibernate.sourceforge.net/
-->

<class 
    name="mx.com.web2lab.backend.hbm.om.ap.medico.puntos.CRegalo" 
    table="c_regalo"
>

    <id
        name="cregalo"
        type="int"
        column="cregalo"
    >
        <generator class="sequence">
             	<param name="sequence">c_regalo_sequence</param>
        </generator>
    </id>

    <property
        name="sregalo"
        type="java.lang.String"
        column="sregalo"
        length="60"
    />
    <property
        name="uvalorpuntos"
        type="int"
        column="uvalorpuntos"
        length="8"
    />
    <property
        name="ucategoriamedico"
        type="int"
        column="ucategoriamedico"
        length="10"
    />
    <property
        name="dregistro"
        type="java.sql.Timestamp"
        column="dregistro"
        length="29"
    />
    <property
        name="cestadoregistro"
        type="int"
        column="cestadoregistro"
        not-null="true"
        length="10"
    />

    <!-- associations -->
    <!-- bi-directional one-to-many association to TRegaloMedico -->
    <set
        name="tregalomedicos"
        lazy="true"
        inverse="true"
    >
        <key>
            <column name="cregalo" />
        </key>
        <one-to-many 
            class="mx.com.web2lab.backend.hbm.om.ap.medico.puntos.TRegaloMedico"
        />
    </set>
</class>
</hibernate-mapping>
