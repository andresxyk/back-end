<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
    "-//Hibernate/Hibernate Mapping DTD 2.0//EN"
    "http://hibernate.sourceforge.net/hibernate-mapping-2.0.dtd" >
    
<hibernate-mapping>
<!-- 
    Created by the Middlegen Hibernate plugin

    http://boss.bekk.no/boss/middlegen/
    http://hibernate.sourceforge.net/
-->

<class 
    name="mx.com.web2lab.backend.hbm.om.ap.EConvenioClasificacion" 
    table="e_convenio_clasificacion"
>

    <id
        name="kconvenioclasificaion"
        type="int"
        column="kconvenioclasificaion"
    >
        <generator class="sequence">
             	<param name="sequence">econvenioclasificacion_sequence</param>
        </generator>
    </id>

    <property
        name="pdescuento"
        type="java.math.BigDecimal"
        column="pdescuento"
        length="8"
    />

    <!-- associations -->
    <!-- bi-directional many-to-one association to CTipoComercial -->
    <many-to-one
        name="cclasificacioncomercial"
        class="mx.com.web2lab.backend.hbm.om.ap.CClasificacionComercial"
        not-null="true"
    >
        <column name="cclasificacioncomercial" />
    </many-to-one>
    <!-- bi-directional many-to-one association to CConvenio -->
    <many-to-one
        name="cconvenio"
        class="mx.com.web2lab.backend.hbm.om.ap.CConvenio"
        not-null="true"
    >
        <column name="cconvenio" />
    </many-to-one>
</class>
</hibernate-mapping>
