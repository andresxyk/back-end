<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
    "-//Hibernate/Hibernate Mapping DTD 2.0//EN"
    "http://hibernate.sourceforge.net/hibernate-mapping-2.0.dtd" >
    
<hibernate-mapping>
<!-- 
    Created by the Middlegen Hibernate plugin

    http://boss.bekk.no/boss/middlegen/
    http://hibernate.sourceforge.net/
-->

<class 
    name="mx.com.web2lab.backend.hbm.om.ap.CNominacion" 
    table="c_nominacion"
>

    <id
        name="knominacion"
        type="int"
        column="knominacion"
    >
        <generator class="assigned" />
    </id>

    <property
        name="snominacion"
        type="java.lang.String"
        column="snominacion"
        length="40"
    />

    <!-- associations -->
    <!-- bi-directional one-to-many association to TCorteCajaArqueo -->
    <set
        name="tcortecajaarqueos"
        lazy="true"
        inverse="true"
    >
        <key>
            <column name="knominacion" />
        </key>
        <one-to-many 
            class="mx.com.web2lab.backend.hbm.om.ap.TCorteCajaArqueo"
        />
    </set>

</class>
</hibernate-mapping>
