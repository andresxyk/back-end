<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
    "-//Hibernate/Hibernate Mapping DTD 2.0//EN"
    "http://hibernate.sourceforge.net/hibernate-mapping-2.0.dtd" >
    
<hibernate-mapping>
<!-- 
    Created by the Middlegen Hibernate plugin

    http://boss.bekk.no/boss/middlegen/
    http://hibernate.sourceforge.net/
-->

<class 
    name="mx.com.web2lab.backend.hbm.om.ap.EMedicoDetalle" 
    table="e_medico_detalle"
>

    <id
        name="kmedicodetalle"
        type="int"
        column="kmedicodetalle"
    >
        <generator class="assigned" />
    </id>


    <!-- associations -->
    <!-- bi-directional many-to-one association to EMedicoPaquete -->
    <many-to-one
        name="emedicopaquete"
        class="mx.com.web2lab.backend.hbm.om.ap.EMedicoPaquete"
        not-null="true"
    >
        <column name="kmedicopaquete" />
    </many-to-one>
    <!-- bi-directional many-to-one association to CExamen -->
    <many-to-one
        name="cexamen"
        class="mx.com.web2lab.backend.hbm.om.lis.CExamen"
        not-null="true"
    >
        <column name="cexamen" />
    </many-to-one>

</class>
</hibernate-mapping>
