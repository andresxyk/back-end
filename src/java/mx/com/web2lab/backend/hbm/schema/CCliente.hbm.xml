        length="50"
    />
    <property
        name="smnemonico"
        type="java.lang.String"
        column="smnemonico"
        length="15"
    />
    <property
        name="sdireccion"
        type="java.lang.String"
        column="sdireccion"
        length="100"
    />
    <property
        name="sobservaciones"
        type="java.lang.String"
        column="sobservaciones"
        length="200"
    />
    <property
        name="userid"
        type="java.math.BigDecimal"
        column="user_id"
        not-null="true"
        length="131089"
    />
    <property
        name="dregistro"
        type="java.sql.Timestamp"
        column="dregistro"
        length="29"
    />
    <property
        name="cgirocliente"
        type="int"
        column="cgirocliente"
        not-null="true"
        length="8"
    />
    <property
        name="czonaventa"
        type="int"
        column="czonaventa"
        not-null="true"
        length="8"
    />
    <property
        name="cmarca"
        type="int"
        column="cmarca"
        not-null="true"
        length="8"
    />
    
    <property
        name="cregimenfiscal"
        type="int"
        column="cregimenfiscal"
        not-null="true"
        length="8"
    />
    
    <property
        name="cusocfdi"
        type="int"
        column="cusocfdi"
        not-null="true"
        length="8"
    />
    
    <property
        name="udiascredito"
        type="int"
        column="udiascredito"
        not-null="true"
        length="4"
    />
    
    
    <property name="ssector" column="ssector" type="string"/>
        <property name="sejecutivocobranza" column="sejecutivocobranza" type="string"/>
        <property name="scorreoejecutivocobranza" column="scorreoejecutivocobranza" type="string"/>
        <property name="snombreejecutivocomercial" column="snombreejecutivocomercial" type="string"/>
        <property name="scorreoejecutivocomercial" column="scorreoejecutivocomercial" type="string"/>
        <property name="snombrecontacto" column="snombrecontacto" type="string"/>
        <property name="stelefonocontacto" column="stelefonocontacto" type="string"/>
        <property name="scorreocontacto" column="scorreocontacto" type="string"/>
        <property name="bcuentapromesapago" column="bcuentapromesapago" type="boolean"/>
        <property name="sindicacionesadicionalescobro" column="sindicacionesadicionalescobro" type="string"/>
        <property name="scanalenvio" column="scanalenvio" type="string"/>
        <property name="shorariodiaentrega" column="shorariodiaentrega" type="string"/>
        <property name="sdomicilioentrega" column="sdomicilioentrega" type="string"/>
        <property name="sligaportal" column="sligaportal" type="string"/>
        <property name="susuarioportal" column="susuarioportal" type="string"/>
        <property name="scontrasenaportal" column="scontrasenaportal" type="string"/>
        
        <!-- Ejecutivo Comercial -->
		<property name="sdeptoejecomer" column="sdeptoejecomer" type="string" length="100"/>
		<property name="sdirejecomer" column="sdirejecomer" type="string" length="100"/>
		<property name="stelejecomer" column="stelejecomer" type="string" length="100"/>
		
		<!-- Contacto -->
		<property name="sdeptocontacto" column="sdeptocontacto" type="string" length="100"/>
		<property name="sdircontacto" column="sdircontacto" type="string" length="100"/>
		<property name="sdiashrscontacto" column="sdiashrscontacto" type="string" length="100"/>
		<property name="dfeccierrecontacto" column="dfeccierrecontacto" type="string"/>
		
		<!-- Ejecutivo de Cobranza -->
		<property name="sdeptoejecob" column="sdeptoejecob" type="string" length="100"/>
		<property name="sdirejecob" column="sdirejecob" type="string" length="100"/>
		<property name="stelejecob" column="stelejecob" type="string" length="100"/>

    <!-- associations -->
    <!-- bi-directional many-to-one association to CCodigoPostal -->
    <many-to-one
        name="ccodigopostal"
        class="mx.com.web2lab.backend.hbm.om.ap.CCodigoPostal"
        not-null="true"
    >
        <column name="ccodigopostal" />
    </many-to-one>
    <!-- bi-directional many-to-one association to CTipoCliente -->
    <many-to-one
        name="ctipocliente"
        class="mx.com.web2lab.backend.hbm.om.ap.CTipoCliente"
        not-null="true"
    >
        <column name="ctipocliente" />
    </many-to-one>


    <!-- bi-directional many-to-one association to CTipoPersona -->
    <many-to-one
        name="ctipopersona"
        class="mx.com.web2lab.backend.hbm.om.ap.CTipoPersona"
        not-null="true"
    >
        <column name="ctiipopersona" />
    </many-to-one>
    <!-- bi-directional many-to-one association to CEstadoRegistro -->
    <many-to-one
        name="cestadoregistro"
        class="mx.com.web2lab.backend.hbm.om.ap.CEstadoRegistro"
        not-null="true"
    >
        <column name="cestadoregistro" />
    </many-to-one>
    <!-- bi-directional one-to-many association to CConvenio -->
    <set
        name="cconvenios"
        lazy="true"
        inverse="true"
    >
        <key>
            <column name="ccliente" />
        </key>
        <one-to-many 
            class="mx.com.web2lab.backend.hbm.om.ap.CConvenio"
        />
    </set>

</class>
</hibernate-mapping>
