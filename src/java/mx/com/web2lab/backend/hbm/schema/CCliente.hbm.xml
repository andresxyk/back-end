<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
    "-//Hibernate/Hibernate Mapping DTD 2.0//EN"
    "http://hibernate.sourceforge.net/hibernate-mapping-2.0.dtd" >
    
<hibernate-mapping>
<!-- 
    Created by the Middlegen Hibernate plugin

    http://boss.bekk.no/boss/middlegen/
    http://hibernate.sourceforge.net/
-->

<class 
    name="mx.com.web2lab.backend.hbm.om.ap.CCliente" 
    table="c_cliente"
>

    <id
        name="ccliente"
        type="int"
        column="ccliente"
    >
        <generator class="sequence">
             	<param name="sequence">ccliente_sequence</param>
        </generator>
    </id>

    <property
        name="srazonsocial"
        type="java.lang.String"
        column="srazonsocial"
        length="150"
    />
    <property
        name="srfc"
        type="java.lang.String"
        column="srfc"
        length="50"
    />
    <property
        name="smnemonico"
        type="java.lang.String"
        column="smnemonico"
        length="15"
    />
    <property
        name="sdireccion"
        type="java.lang.String"
        column="sdireccion"
        length="100"
    />
    <property
        name="sobservaciones"
        type="java.lang.String"
        column="sobservaciones"
        length="200"
    />
    <property
        name="userid"
        type="java.math.BigDecimal"
        column="user_id"
        not-null="true"
        length="131089"
    />
    <property
        name="dregistro"
        type="java.sql.Timestamp"
        column="dregistro"
        length="29"
    />
    <property
        name="cgirocliente"
        type="int"
        column="cgirocliente"
        not-null="true"
        length="8"
    />
    <property
        name="czonaventa"
        type="int"
        column="czonaventa"
        not-null="true"
        length="8"
    />
    <property
        name="cmarca"
        type="int"
        column="cmarca"
        not-null="true"
        length="8"
    />
    
    <property
        name="cregimenfiscal"
        type="int"
        column="cregimenfiscal"
        not-null="true"
        length="8"
    />
    
    <property
        name="cusocfdi"
        type="int"
        column="cusocfdi"
        not-null="true"
        length="8"
    />
    
    <property
        name="udiascredito"
        type="int"
        column="udiascredito"
        not-null="true"
        length="4"
    />
    
    <property
        name="snombrecontacto"
        type="java.lang.String"
        column="snombrecontacto"
        length="100"
    />

    <!-- associations -->
    <!-- bi-directional many-to-one association to CCodigoPostal -->
    <many-to-one
        name="ccodigopostal"
        class="mx.com.web2lab.backend.hbm.om.ap.CCodigoPostal"
        not-null="true"
    >
        <column name="ccodigopostal" />
    </many-to-one>
    <!-- bi-directional many-to-one association to CTipoCliente -->
    <many-to-one
        name="ctipocliente"
        class="mx.com.web2lab.backend.hbm.om.ap.CTipoCliente"
        not-null="true"
    >
        <column name="ctipocliente" />
    </many-to-one>


    <!-- bi-directional many-to-one association to CTipoPersona -->
    <many-to-one
        name="ctipopersona"
        class="mx.com.web2lab.backend.hbm.om.ap.CTipoPersona"
        not-null="true"
    >
        <column name="ctiipopersona" />
    </many-to-one>
    <!-- bi-directional many-to-one association to CEstadoRegistro -->
    <many-to-one
        name="cestadoregistro"
        class="mx.com.web2lab.backend.hbm.om.ap.CEstadoRegistro"
        not-null="true"
    >
        <column name="cestadoregistro" />
    </many-to-one>
    <!-- bi-directional one-to-many association to CConvenio -->
    <set
        name="cconvenios"
        lazy="true"
        inverse="true"
    >
        <key>
            <column name="ccliente" />
        </key>
        <one-to-many 
            class="mx.com.web2lab.backend.hbm.om.ap.CConvenio"
        />
    </set>

</class>
</hibernate-mapping>
