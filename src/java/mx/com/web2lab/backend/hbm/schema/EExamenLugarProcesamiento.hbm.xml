<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
    "-//Hibernate/Hibernate Mapping DTD 2.0//EN"
    "http://hibernate.sourceforge.net/hibernate-mapping-2.0.dtd" >
    
<hibernate-mapping>
<!-- 
    Created by the Middlegen Hibernate plugin

    http://boss.bekk.no/boss/middlegen/
    http://hibernate.sourceforge.net/
-->

<class 
    name="mx.com.web2lab.backend.hbm.om.ap.EExamenLugarProcesamiento" 
    table="e_examen_lugar_procesamiento"
>

    <id
        name="kexamenprocesamiento"
        type="int"
        column="kexamenprocesamiento"
    >
        <generator class="assigned" />
    </id>


    <!-- associations -->
    <!-- bi-directional many-to-one association to CExamen -->
    <many-to-one
        name="cexamen"
        class="mx.com.web2lab.backend.hbm.om.lis.CExamen"
        not-null="true"
    >
        <column name="cexamen" />
    </many-to-one>
    <!-- bi-directional many-to-one association to CLugarProcesamiento -->
    <many-to-one
        name="clugarprocesamiento"
        class="mx.com.web2lab.backend.hbm.om.lis.CLugarProcesamiento"
        not-null="true"
    >
        <column name="clugarprocesamiento" />
    </many-to-one>

</class>
</hibernate-mapping>
