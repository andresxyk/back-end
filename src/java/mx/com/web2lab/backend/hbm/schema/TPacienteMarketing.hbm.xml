<class 
    name="mx.com.web2lab.backend.hbm.om.ap.TPacienteMarketing" 
    table="t_paciente_marketing"
>

    <id
        name="kpacientemarketing"
        type="int"
        column="kpacientemarketing"
    >
        <generator class="sequence">
             	<param name="sequence">tpacientemarketing_sequence</param>
        </generator>
    </id>

    <property
        name="dregistro"
        type="java.sql.Timestamp"
        column="dregistro"
        length="29"
    />
    <property
        name="userId"
        type="int"
        column="user_id"
        not-null="true"
        length="8"
    />

    <!-- associations -->
    <!-- bi-directional many-to-one association to CPromocionMarketing -->
    <many-to-one
        name="cpromocionmarketing"
        class="mx.com.web2lab.backend.hbm.om.ap.CPromocionMarketing"
        not-null="true"
    >
        <column name="cpromocionenviomarketing" />
    </many-to-one>
    <!-- bi-directional many-to-one association to TPaciente -->
    <many-to-one
        name="tpaciente"
        class="mx.com.web2lab.backend.hbm.om.ap.TPaciente"
        not-null="true"
    >
        <column name="kpaciente" />
    </many-to-one>

</class>
