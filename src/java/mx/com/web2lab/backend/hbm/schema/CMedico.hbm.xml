        name="bregistrado"
        type="boolean"
        column="bregistrado"
        length="1"
    />
    <property
        name="cformapagomedico"
        type="int"
        column="cformapagomedico"
        length="8"
    />
    <property
        name="shorariovisita"
        type="java.lang.String"
        column="shorariovisita"
        length="50"
    />
    <property
        name="scurp"
        type="java.lang.String"
        column="scurp"
        length="80"
    />
    <property
        name="ucategoriamedico"
        type="int"
        column="ucategoriamedico"
        length="8"
    />

    <!-- associations -->
    <!-- bi-directional many-to-one association to CEstadoRegistro -->
    <many-to-one
        name="cestadoregistro"
        class="mx.com.web2lab.backend.hbm.om.ap.CEstadoRegistro"
        not-null="true"
    >
        <column name="cestadoregistro" />
    </many-to-one>
    <!-- bi-directional one-to-many association to CDireccionMedico -->
    <set
        name="cdireccionmedicos"
        lazy="true"
        inverse="true"
    >
        <key>
