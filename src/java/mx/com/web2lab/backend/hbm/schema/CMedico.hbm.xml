        </generator>
    </id>

    <property
        name="cclave"
        type="int"
        column="cclave"
        length="8"
    />
    <property
        name="snombre"
        type="java.lang.String"
        column="snombre"
        length="150"
    />
    <property
        name="sapellidopaterno"
        type="java.lang.String"
        column="sapellidopaterno"
        length="70"
    />
