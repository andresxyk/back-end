<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
    "-//Hibernate/Hibernate Mapping DTD 2.0//EN"
    "http://hibernate.sourceforge.net/hibernate-mapping-2.0.dtd" >
    
<hibernate-mapping>
<!-- 
    Created by the Middlegen Hibernate plugin

    http://boss.bekk.no/boss/middlegen/
    http://hibernate.sourceforge.net/
-->

<class 
    name="mx.com.web2lab.backend.hbm.om.ap.CTipoPagoFactura" 
    table="c_tipo_pago_factura"
>

    <id
        name="ctipopago"
        type="int"
        column="ctipopago"
    >
        <generator class="assigned" />
    </id>

    <property
        name="stipopago"
        type="java.lang.String"
        column="stipopago"
        length="50"
    />

    <!-- associations -->
    <!-- bi-directional one-to-many association to TPagoFactura -->
    <set
        name="tpagofacturas"
        lazy="true"
        inverse="true"
    >
        <key>
            <column name="ctipopago" />
        </key>
        <one-to-many 
            class="mx.com.web2lab.backend.hbm.om.ap.TPagoFactura"
        />
    </set>

</class>
</hibernate-mapping>
