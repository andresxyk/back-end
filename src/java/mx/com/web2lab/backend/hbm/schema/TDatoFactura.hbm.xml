        type="int"
        column="ccodigopostal"
        not-null="true"
        length="8"
    />
    <property
        name="cestadoregistro"
        type="int"
        column="cestadoregistro"
        not-null="true"
        length="8"
    />
    <property
        name="userid"
        type="java.math.BigDecimal"
        column="user_id"
        not-null="true"
        length="131089"
    />
    <property
        name="dregistro"
        type="java.sql.Timestamp"
        column="dregistro"
        length="29"
    />

    <!-- associations -->
    <!-- bi-directional one-to-many association to TOrdenFacturaSucursal -->
    <set
        name="tordenfacturasucursals"
        lazy="true"
        inverse="true"
    >
        <key>
